#!/bin/bash
# Enterprise automated backup script managed by Ansible

BACKUP_DIR="/var/www/html/web_app/backups"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")

mkdir -p $BACKUP_DIR

# If this machine is the database server, back up the database schema
if [ "$(hostname -s)" == "db" ]; then
    mysqldump --user=app_user --password={{ vault_db_password }} --host=localhost web_app_db > $BACKUP_DIR/db_backup_$TIMESTAMP.sql
    find $BACKUP_DIR -name "db_backup_*.sql" -mtime +7 -delete
fi

# If this machine is a web server, back up the configuration files
if [[ "$(hostname -s)" == web* ]]; then
    tar -czf $BACKUP_DIR/web_config_$TIMESTAMP.tar.gz /etc/httpd/conf.d/
    find $BACKUP_DIR -name "web_config_*.tar.gz" -mtime +7 -delete
fi
